# Цель: nightly-сборка на dev.die.samoy.love.
#
# Отдельная цель, а не ветка того же сайта: проверять новую версию нужно
# ровно так же, как её увидит игрок, но не роняя при этом прод. Сюда же
# смотрит агент, когда нужен не локальный запуск, а собранный бандл.

APP=die-dev
BUILD_CMD="npm ci && npm run build"
ARTIFACT_DIR=dist

ROOT=/var/www/die-dev
OWNER=www-data:www-data

# Конфига nginx у этой цели нет намеренно: оба домена описаны одним файлом,
# и ставит его прод (см. .deploy-kit/game.env). Перезагрузка нужна и здесь —
# после подмены симлинка релиза.
NGINX_RELOAD=1

HEALTH=https://dev.die.samoy.love/
VERSION_URL=https://dev.die.samoy.love/version.json

KEEP=3

# Молчит по той же причине, что и прод: голос о релизах один — бот
# samoy-status. Nightly он не опрашивает вовсе, и это осознанно: успешная
# ночная сборка не новость, а провал виден красным в Actions.
NOTIFY=never
