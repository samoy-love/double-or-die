# Цель: nightly-сборка на dev.die.samoy.love.
#
# Отдельная цель, а не ветка того же сайта: проверять новую версию нужно
# ровно так же, как её увидит игрок, но не роняя при этом прод. Сюда же
# смотрит агент, когда нужен не локальный запуск, а собранный бандл.

APP=die-dev
BUILD_CMD="npm ci && npm run build"
ARTIFACT_DIR=dist

ROOT=/var/www/die-dev
OWNER=www-data:www-data

# Конфига nginx у этой цели нет намеренно: оба домена описаны одним файлом,
# и ставит его прод (см. .deploy-kit/game.env). Перезагрузка нужна и здесь —
# после подмены симлинка релиза.
NGINX_RELOAD=1

HEALTH=https://dev.die.samoy.love/
VERSION_URL=https://dev.die.samoy.love/version.json

# Соседи проверяются и здесь, хотя цель ночная.
#
# Домены прода и nightly описаны ОДНИМ файлом nginx, и NGINX_RELOAD=1 у этой
# цели стоит: перечитывание конфига после ночной сборки задевает ровно тех же
# соседей, что и выкатка прода. Список без них означал бы, что упавший от
# ночной выкатки чужой домен обнаружит его владелец, а не пайплайн.
#
# die.samoy.love в списке первым: ближайший пострадавший от правки общего
# конфига — прод той же игры.
NEIGHBOURS=die.samoy.love,samoy.love,metro.samoy.love,snakes.samoy.love,launcher.samoy.love,status.samoy.love

KEEP=3

# Молчит по той же причине, что и прод: голос о релизах один — бот
# samoy-status. Nightly он не опрашивает вовсе, и это осознанно: успешная
# ночная сборка не новость, а провал виден красным в Actions.
NOTIFY=never

# ------------------------------------------------------------ локальный запуск
#
# Локально nightly не поднимается, и это не пробел в описании. dev и прод —
# одно и то же дерево, отличаются они доменом и моментом сборки, а не кодом.
# Второй `npm run dev` из того же каталога дал бы вторую копию той же игры на
# другом порту и ничего бы не проверил: разницу между dev.die и die видно
# только на сервере.
RUN_SKIP="то же дерево, что и die-game — локально второй сборки не бывает"
