# Цель: nightly-сборка на dev.die.samoy.love.
#
# Отдельная цель, а не ветка того же сайта: проверять новую версию нужно
# ровно так же, как её увидит игрок, но не роняя при этом прод. Сюда же
# смотрит агент, когда нужен не локальный запуск, а собранный бандл.

APP=die-dev
BUILD_CMD="npm ci && npm run build"
ARTIFACT_DIR=dist

ROOT=/var/www/die-dev
OWNER=ubuntu:ubuntu

NGINX_RELOAD=1
# NGINX_DEST здесь нет намеренно. Конфиг ставится парой NGINX_CONF+NGINX_DEST,
# и одна половина без другой — не «частично настроено», а молча пропущенный
# шаг: deploy-kit просто не трогает nginx. Оба домена описаны ОДНИМ файлом
# `nginx/sites/die.samoy.love.conf` в deploy-kit и применяются оттуда
# `nginx-apply.sh`, а не выкаткой игры. Пара появится здесь, когда этот файл
# будет в `main` deploy-kit.

HEALTH=https://dev.die.samoy.love/
VERSION_URL=https://dev.die.samoy.love/version.json

# Успешная выкатка nightly не новость: сообщать о ней в чат каждый раз —
# верный способ перестать читать уведомления вообще.
NOTIFY=fail

KEEP=3
