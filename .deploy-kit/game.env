# Цель: играбельная веб-сборка на die.samoy.love.
#
# Читают и CI (reusable workflow из deploy-kit), и локальный
# `dk deploy` — поэтому оба пути катят одинаково.
#
# Игра статическая: весь геймплей считается в браузере, бэкенд ей нужен
# только под телеметрию и лидерборды, и появится он в 0.11.0.

# APP совпадает с id проекта в реестре бота samoy-status (config/status.json
# репозитория status.samoy.love: "id": "die"). У бота нет отдельной записи
# под "die-game" — несовпадающий APP оставлял бы прод в карточке релиза без
# названия и без ссылки, и то же самое ждёт любую другую цель хозяйства, если
# завести ей APP не по id проекта.
APP=die
BUILD_CMD="npm ci && npm run build"
ARTIFACT_DIR=dist

ROOT=/var/www/die
OWNER=www-data:www-data

NGINX_RELOAD=1
# Конфиг сайта живёт в deploy-kit — путь считается от корня ТОГО репозитория.
# Читают обе выкатки, локальная и пайплайн; применяет nginx-apply.sh на сервере
# с бэкапом, nginx -t и откатом.
#
# Файл ОДИН на оба домена, прод и nightly, и применяется он отсюда — из
# прода. У цели dev своей пары нет намеренно: два описания, ставящие один и
# тот же файл, однажды разъедутся, и какое из них выиграет, будет зависеть от
# порядка выкатки.
NGINX_CONF=nginx/sites/die.samoy.love.conf
NGINX_DEST=/etc/nginx/sites-available/die.samoy.love.conf

HEALTH=https://die.samoy.love/
VERSION_URL=https://die.samoy.love/version.json

# Соседи проверяются после выкатки: чужой сайт, упавший от нашей правки
# nginx, иначе обнаруживается его владельцем и через сутки.
NEIGHBOURS=samoy.love,metro.samoy.love,snakes.samoy.love,launcher.samoy.love,status.samoy.love

KEEP=5

# О релизе объявляет бот samoy-status, а не CI. Агент опрашивает
# /version.json каждую минуту, видит смену версии и пишет в чат сам — поэтому
# сообщения приходят, хотя TELEGRAM_BOT_TOKEN задан ровно в одном репозитории
# из шести. Если завести токен и здесь, на каждый релиз придёт ДВА сообщения
# об одном и том же. Голос остаётся один — бот, а выкатка молчит осознанно.
# Молчание задаётся здесь, а не отсутствием секрета: пустой секрет пайплайн
# считает недосмотром и ругается предупреждением «о релизе никто не узнал».
# NOTIFY=never он проверял РАНЬШЕ токена, поэтому предупреждения не было.
#
# Теперь о выкатке рассказывает сама выкатка, событием и в тот же момент.
# Дублей это не создаёт: цель не ходит в Telegram сама, она кладёт событие в
# общий журнал, а разбирает его и говорит по-прежнему один голос — бот. Обе
# цели репозитория катятся одним прогоном, поэтому в чат уйдёт одна карточка
# на прогон, а не по одной на цель.
NOTIFY=all

# ------------------------------------------------------------ локальный запуск
#
# Ключи RUN_* читает `dk run`. Порт задан ЯВНО и не совпадает с 5173 из
# vite.config.ts: на 5173 сидит metro, а Vite при занятом порте молча уезжает
# на соседний — запусти игру и карту разом, и игра оказалась бы не по тому
# адресу, который назвал бы себе же открытый рядом браузер. --strictPort
# превращает молчаливый переезд в честную ошибку.
RUN_CMD="npm run dev -- --port %PORT% --strictPort"
RUN_PORT=5175

# Бэкенда у игры нет: весь геймплей считается в браузере, и локально она
# самодостаточна — ни телеметрии, ни лидербордов до 0.11.0.
