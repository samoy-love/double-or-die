# Цель: играбельная веб-сборка на die.samoy.love.
#
# Игра статическая: весь геймплей считается в браузере, бэкенд ей нужен
# только под телеметрию и лидерборды, и появится он в 0.11.0.

APP=die-game
BUILD_CMD="npm ci && npm run build"
ARTIFACT_DIR=dist

ROOT=/var/www/die
OWNER=ubuntu:ubuntu

NGINX_RELOAD=1
# NGINX_DEST здесь нет намеренно. Конфиг ставится парой NGINX_CONF+NGINX_DEST,
# и одна половина без другой — не «частично настроено», а молча пропущенный
# шаг: deploy-kit просто не трогает nginx. Оба домена описаны ОДНИМ файлом
# `nginx/sites/die.samoy.love.conf` в deploy-kit и применяются оттуда
# `nginx-apply.sh`, а не выкаткой игры. Пара появится здесь, когда этот файл
# будет в `main` deploy-kit.

HEALTH=https://die.samoy.love/
VERSION_URL=https://die.samoy.love/version.json

NEIGHBOURS=samoy.love,status.samoy.love,snakes.samoy.love

KEEP=5
