node_modules/
dist/
.DS_Store

# Файлы окружения. Своих переменных у игры сейчас нет, но запрет заводится
# заранее: то, что появится, обязано появиться уже под ним. Хук pre-commit
# проверяет то же самое — .gitignore защищает от добавления, хук от `git add -f`.
.env
.env.*
!.env.example

# Каталог сборки: артефакт кладёт туда пайплайн при выкатке,
# в репозитории ему делать нечего.
stage/

# Отчёты покрытия и тестов, включая следы сквозных прогонов.
coverage/
test-results/
playwright-report/

# Логи забегов, снятые локально: их место в баг-репорте, а не в истории.
runs/

# Отчёты балансировщика — их пересчитывают, а не хранят.
balance-report/

# Рабочие копии агентов: отдельные git-репозитории внутри нашего.
# Без этой строки `git add -A` затягивает их целиком — сто тысяч строк
# чужой истории в обычный коммит, и замечает это только тот, кто смотрит
# статистику дифа.
.claude/worktrees/
