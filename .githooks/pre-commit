#!/bin/sh
# Не пускать секреты в коммит.
#
# Сами правила — в `scripts/check-secrets.sh`, и там же объяснено, почему они
# вынесены отдельно: хук обходится флагом `--no-verify` и не действует на чужих
# машинах, поэтому те же правила стоят ещё и в CI. Два списка шаблонов,
# живущих порознь, неизбежно расходятся — список один, зовут его двое.
#
# Включается один раз на репозиторий, вместе с commit-msg:
#
#     git config core.hooksPath .githooks
#
# Обойти осознанно: git commit --no-verify. Это нормальный путь для правки
# самого хука или его тестов — но не для «сейчас некогда». В CI такого пути
# нет: там проверка тех же добавляемых строк идёт по диффу PR.

set -e

root="$(git rev-parse --show-toplevel)"
scanner="$root/scripts/check-secrets.sh"

# Пропавший сканер — не повод пропустить коммит. Проверка, которую нельзя
# выполнить, не то же самое, что пройденная: именно так тихо умирают гейты.
if [ ! -f "$scanner" ]; then
    echo "✗ Нет $scanner — проверка на секреты не выполнена." >&2
    exit 1
fi

sh "$scanner" --staged
