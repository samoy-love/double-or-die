#!/bin/sh
# Не пускать секреты в коммит.
#
# Утёкший ключ чистится переписыванием опубликованной истории и отзывом самого
# ключа — это дороже любого неудобства здесь. Причём заметить утечку обычно
# некому: коммит выглядит обычным, CI зелёный, а ключ уже в истории навсегда.
#
# Проверяются только ДОБАВЛЯЕМЫЕ строки индекса, а не файлы целиком: иначе хук
# ругался бы на давно лежащий в репозитории текст при каждом коммите, и его
# отключили бы через неделю.
#
# Включается один раз на репозиторий, вместе с commit-msg:
#
#     git config core.hooksPath .githooks
#
# Обойти осознанно: git commit --no-verify. Это нормальный путь для правки
# самого хука или его тестов — но не для «сейчас некогда».

set -e

# Двоичные файлы из диффа выкидываем: искать в них подстроки бессмысленно,
# а вывод они ломают.
added="$(git diff --cached --diff-filter=ACM -U0 --no-color -- . \
  | grep -E '^\+' | grep -Ev '^\+\+\+' || true)"

[ -n "$added" ] || exit 0

# Шаблоны намеренно узкие: широкие («password», «token» где угодно) дают
# ложные срабатывания на комментариях и именах полей, а хук, который врёт,
# перестают читать.
#
#   1. Приватные ключи любого вида — самый дорогой случай.
#   2. Токены с узнаваемым префиксом: GitHub, Telegram, AWS, Slack.
#   3. Присваивание секрета непустым литералом в коде и в .env.
patterns='-----BEGIN [A-Z ]*PRIVATE KEY-----
gh[pousr]_[A-Za-z0-9]{16,}
github_pat_[A-Za-z0-9_]{20,}
[0-9]{8,10}:AA[A-Za-z0-9_-]{30,}
AKIA[0-9A-Z]{16}
xox[baprs]-[A-Za-z0-9-]{10,}
(SECRET|TOKEN|PASSWORD|PASSWD|API_KEY|PRIVATE_KEY)[A-Z_]*\s*[=:]\s*["'"'"']?[A-Za-z0-9/+_-]{16,}'

# Шаблоны уезжают во временный файл и читаются через -f.
#
# Не для красоты: первый шаблон начинается с дефисов, и переданный аргументом
# он был бы принят за опции grep. Ошибку разбора при этом легко не заметить —
# grep вернёт код 2, а привычное `|| true` превратит его в «совпадений нет».
# Так проверка и умирает: хук на месте, файл лежит, секреты проходят.
pfile="$(mktemp)"
trap 'rm -f "$pfile"' EXIT
printf '%s\n' "$patterns" > "$pfile"

set +e
hits="$(printf '%s\n' "$added" | grep -nEi -f "$pfile")"
rc=$?
set -e

# Коды grep: 0 — нашёл, 1 — не нашёл, всё остальное — сам сломался. Последнее
# обязано валить коммит: проверку, которую нельзя выполнить, нельзя считать
# пройденной.
if [ "$rc" -gt 1 ]; then
    echo "✗ Проверка на секреты не отработала (grep вернул $rc)." >&2
    echo "  Коммит остановлен: непройденная проверка — не то же самое, что чистая." >&2
    exit 1
fi

if [ -n "$hits" ]; then
    echo "✗ Похоже на секрет в добавляемых строках:" >&2
    echo "$hits" | head -10 >&2
    echo >&2
    echo "  Секрет из истории убирается только переписыванием и отзывом ключа." >&2
    echo "  Если это ложное срабатывание — git commit --no-verify." >&2
    exit 1
fi

# Файлы окружения не коммитятся никогда: даже пустой сегодня, завтра он
# наполнится, и правка пройдёт незамеченной.
staged_env="$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)\.env(\.|$)' | grep -v '\.env\.example$' || true)"

if [ -n "$staged_env" ]; then
    echo "✗ В коммит попал файл окружения:" >&2
    echo "$staged_env" >&2
    echo "  Образец без значений — .env.example; настоящий .env остаётся у вас." >&2
    exit 1
fi

exit 0
