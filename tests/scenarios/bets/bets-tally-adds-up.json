{
  "name": "Счётчики забега сходятся: взято равно выиграно плюс проиграно плюс обналичено",
  "seed": 1,
  "players": 1,
  "steps": [
    { "clear": true },
    { "chips": { "amount": 200 } },
    { "bet": { "id": "no_damage", "stake": 10 } },
    { "bet": { "id": "no_dash", "stake": 10 } },
    { "bet": { "id": "under_45s", "stake": 10 } },
    { "expect": { "bets": { "taken": { "min": 3, "max": 3 }, "active": { "min": 3, "max": 3 } } } },
    { "input": { "move": [1, 0], "buttons": ["dash"] } },
    { "tick": 2 },
    { "clearInput": {} },
    { "expect": { "bets": { "id": "no_dash", "state": "lost", "lost": { "min": 1, "max": 1 } } } },
    { "tick": 600 },
    { "cashOut": { "id": "under_45s" } },
    { "settle": true },
    {
      "expect": {
        "bets": {
          "taken": { "min": 3, "max": 3 },
          "won": { "min": 1, "max": 1 },
          "lost": { "min": 1, "max": 1 },
          "cashed": { "min": 1, "max": 1 }
        }
      }
    },
    { "expect": { "bets": { "id": "no_damage", "state": "won" } } },
    { "expect": { "bets": { "id": "under_45s", "state": "cashed" } } }
  ]
}
