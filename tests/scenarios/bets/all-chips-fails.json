{
  "name": "«Собери все фишки» срывается угасшей фишкой, а не подобранной",
  "seed": 1,
  "players": 1,
  "steps": [
    { "clear": true },
    { "chips": { "amount": 100 } },
    { "bet": { "id": "all_chips", "stake": 10 } },
    { "place": { "x": 200, "y": 200 } },
    { "dropChip": { "x": 1600, "y": 900 } },
    { "tick": 60 },
    {
      "expect": {
        "chipsOnFloor": { "min": 1, "max": 1 },
        "bets": { "id": "all_chips", "state": "active" }
      }
