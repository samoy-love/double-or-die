    { "tick": 250 },
    {
      "expect": {
        "chipsOnFloor": { "max": 0 },
        "bets": { "id": "all_chips", "state": "lost", "lost": { "min": 1, "max": 1 } },
        "chips": { "min": 90, "max": 90 }
      }
    }
  ]
}
