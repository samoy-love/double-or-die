{
  "name": "double-or-die",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Твин-стик роглайт, где сложность выбираешь ты сам — пари на самого себя",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "sim": "tsx packages/tools/src/cli.ts",
    "safety": "tsx packages/tools/src/cli.ts --runs 20 --ticks 5400 --bot random --safety --json",
    "bench": "tsx packages/tools/src/bench.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:boundaries && npm run check:palette",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check:palette": "tsx scripts/check-palette.ts",
    "check:no-debug-api": "tsx scripts/check-no-debug-api.ts",
    "assets": "tsx scripts/check-assets.ts",
    "golden": "tsx packages/tools/src/cli.ts --golden tests/golden",
    "scenarios": "tsx packages/tools/src/cli.ts --scenario tests/scenarios",
    "build": "tsc --noEmit && vite build && tsx scripts/write-version.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
